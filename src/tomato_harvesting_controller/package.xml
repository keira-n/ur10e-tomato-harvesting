<?xml version="1.0"?>
<package format="3">
  <name>tomato_harvesting_controller</name>
  <version>0.1.0</version>
  <description>ROS 2 interface for D435 tomato localization and UR10e MoveIt planning.</description>
  <maintainer email="maintainer@example.com">Tomato Harvesting Project</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>shape_msgs</exec_depend>
  <exec_depend>moveit_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>tf2_geometry_msgs</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
  </export>
</package>
